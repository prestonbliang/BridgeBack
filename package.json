{
  "name": "bridgeback",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "postbuild": "node scripts/stamp-worker.mjs",
    "evaluate": "vitest run tests/evaluation.test.ts",
    "sources:check": "node scripts/check-support-sources.mjs",
    "sources:counselors": "node scripts/import-counselors.mjs",
    "ios:bundle": "node scripts/build-ios.mjs",
    "ios:open": "cap open ios",
    "ios:check": "python3 scripts/check-ios.py",
    "ios:art": "node scripts/generate-ios-art.mjs",
    "test:ios-web": "playwright test --config playwright.native.config.ts"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "@xyflow/react": "^12.8.0",
    "dexie": "^4.0.11",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/cli": "^8.5.3",
    "@eslint/eslintrc": "^3.0.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "sharp": "^0.34.5",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
